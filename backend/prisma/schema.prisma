generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  fullName      String      @db.VarChar(120)
  email         String      @unique @db.VarChar(255)
  passwordHash  String
  role          UserRole    @default(EMPLOYEE)
  isActive      Boolean     @default(true)
  createdItems  WorkItem[]  @relation("CreatedBy")
  assignedItems WorkItem[]  @relation("AssignedTo")
  auditLogs     AuditLog[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([role])
  @@map("users")
}

model WorkItem {
  id                 Int        @id @default(autoincrement())
  title              String     @db.VarChar(255)
  description        String?    @db.Text
  status             String     @default("Open") // Open, In Progress, In Review, Blocked, Closed
  priority           String     @default("Medium") // Low, Medium, High, Critical
  team               String     @default("Operations") // Payments, Finance Ops, Engineering, Operations, Compliance
  
  creatorId          String?    @db.Uuid
  creator            User?      @relation("CreatedBy", fields: [creatorId], references: [id], onDelete: SetNull)
  
  assigneeId         String?    @db.Uuid
  assignee           User?      @relation("AssignedTo", fields: [assigneeId], references: [id], onDelete: SetNull)
  
  approvalRequired   Boolean    @default(false)
  resolutionProposal String?    @db.Text
  
  version            Int        @default(1) // For Optimistic Concurrency Control (OCC)
  
  dueAt              DateTime?  @map("due_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  auditLogs          AuditLog[]

  @@index([status])
  @@index([priority])
  @@index([team])
  @@map("work_items")
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  workItemId Int       @map("work_item_id")
  workItem   WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actorId    String?   @db.Uuid @map("actor_id")
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String    // CREATED, STATUS_CHANGED, CLAIMED, ASSIGNED
  details    Json?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("audit_logs")
}