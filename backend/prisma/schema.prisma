generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum TeamRole {
  MEMBER
  MANAGER
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  fullName      String      @db.VarChar(120)
  email         String      @unique @db.VarChar(255)
  passwordHash  String
  role          UserRole    @default(EMPLOYEE)
  isActive      Boolean     @default(true)
  createdItems  WorkItem[]  @relation("CreatedBy")
  assignedItems WorkItem[]  @relation("AssignedTo")
  approvedItems WorkItem[]  @relation("ApprovedBy")
  memberships   TeamMembership[]
  comments      Comment[]
  auditLogs     AuditLog[]
  notifications Notification[]
  lastSeenAt    DateTime?   @map("last_seen_at")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([role])
  @@map("users")
}

model Team {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(120)
  slug        String           @unique @db.VarChar(120)
  memberships TeamMembership[]
  workItems   WorkItem[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("teams")
}

model TeamMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  teamId    String   @db.Uuid @map("team_id")
  role      TeamRole @default(MEMBER)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, teamId])
  @@index([teamId, role])
  @@map("team_memberships")
}

model WorkItem {
  id                 Int        @id @default(autoincrement())
  title              String     @db.VarChar(255)
  description        String?    @db.Text
  category           String     @default("General") @db.VarChar(120)
  status             String     @default("Open") // Open, In Progress, Awaiting Approval, Changes Requested, Approved, Closed, Resolved
  priority           String     @default("Medium") // Low, Medium, High, Critical
  teamId             String     @db.Uuid @map("team_id")
  team               Team       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  
  creatorId          String?    @db.Uuid
  creator            User?      @relation("CreatedBy", fields: [creatorId], references: [id], onDelete: SetNull)
  
  assigneeId         String?    @db.Uuid
  assignee           User?      @relation("AssignedTo", fields: [assigneeId], references: [id], onDelete: SetNull)
  
  approvalRequired   Boolean    @default(false)
  resolutionProposal String?    @db.Text
  resolution         String?    @db.Text
  approvedById       String?    @db.Uuid @map("approved_by_id")
  approvedBy         User?      @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime?  @map("approved_at")
  idempotencyKey     String?    @db.VarChar(100) @map("idempotency_key")
  
  version            Int        @default(1) // For Optimistic Concurrency Control (OCC)
  
  dueAt              DateTime?  @map("due_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  auditLogs          AuditLog[]
  comments           Comment[]
  notifications      Notification[]

  @@unique([creatorId, teamId, idempotencyKey])
  @@index([teamId, status, updatedAt])
  @@index([teamId, assigneeId, status])
  @@index([teamId, priority])
  @@index([dueAt])
  @@map("work_items")
}

model Comment {
  id         Int      @id @default(autoincrement())
  workItemId Int      @map("work_item_id")
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  authorId   String   @db.Uuid @map("author_id")
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([workItemId, createdAt])
  @@map("comments")
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  workItemId Int       @map("work_item_id")
  workItem   WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actorId    String?   @db.Uuid @map("actor_id")
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String    // CREATED, STATUS_CHANGED, CLAIMED, ASSIGNED
  details    Json?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Notification {
  id         Int       @id @default(autoincrement())
  userId     String    @db.Uuid @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItemId Int?      @map("work_item_id")
  workItem   WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  type       String    @db.VarChar(60)
  title      String    @db.VarChar(180)
  message    String    @db.Text
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}
